{
  "name": "ooxml-viewer-vscode",
  "displayName": "OOXML Viewer",
  "description": "High-fidelity local viewer for OOXML documents: Word (.docx, .docm), Excel (.xlsx, .xlsm), and PowerPoint (.pptx, .pptm, .ppsx)",
  "version": "0.1.0",
  "publisher": "TODO: replace me",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "ooxml.docxViewer",
        "displayName": "OOXML Document Viewer",
        "selector": [
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.docm"
          },
          {
            "filenamePattern": "*.dotx"
          },
          {
            "filenamePattern": "*.dotm"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "ooxml.xlsxViewer",
        "displayName": "OOXML Spreadsheet Viewer",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.xltx"
          },
          {
            "filenamePattern": "*.xltm"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "ooxml.pptxViewer",
        "displayName": "OOXML Presentation Viewer",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          },
          {
            "filenamePattern": "*.pptm"
          },
          {
            "filenamePattern": "*.ppsx"
          },
          {
            "filenamePattern": "*.ppsm"
          },
          {
            "filenamePattern": "*.potx"
          },
          {
            "filenamePattern": "*.potm"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs --production",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@silurus/ooxml": "^0.87.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  }
}

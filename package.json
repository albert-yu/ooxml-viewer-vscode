{
  "name": "vscode-ooxml-xlsx-viewer",
  "displayName": "OOXML Spreadsheet Viewer",
  "description": "High-fidelity XLSX / XLSM / XLTX spreadsheet viewer for VS Code powered by @silurus/ooxml",
  "version": "0.1.0",
  "publisher": "silurus",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "ooxml.xlsxViewer",
        "displayName": "OOXML Spreadsheet Viewer",
        "selector": [
          { "filenamePattern": "*.xlsx" },
          { "filenamePattern": "*.xlsm" },
          { "filenamePattern": "*.xltx" },
          { "filenamePattern": "*.xltm" }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs --production",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@silurus/ooxml": "^0.87.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  }
}
